{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "typeRoots": ["test/@types"],
    // This package still emits (`build:ts` = tsc + componentsjs-generator, D1),
    // so it opts out of the base typecheck-only settings.
    "module": "esnext",
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src"]
}
